# Copy to .env (gitignored) and fill in. Loaded by `uv run job-agent`;
# variables already set in your environment take priority over this file.

# Claude API key - https://platform.claude.com -> API Keys. Needed for --provider claude.
ANTHROPIC_API_KEY=

# Ollama server for --provider ollama (defaults to localhost if unset).
OLLAMA_HOST=http://localhost:11434
